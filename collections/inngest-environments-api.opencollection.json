{
  "opencollection": "1.0.0",
  "info": {
    "name": "Inngest REST Account Environments API",
    "version": "2026-05"
  },
  "items": [
    {
      "info": {
        "name": "Environments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Environments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.inngest.com/v2/envs",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List custom and branch environments for the authenticated account."
        },
        {
          "info": {
            "name": "Create Environment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.inngest.com/v2/envs",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates a new custom or branch environment under the account."
        },
        {
          "info": {
            "name": "Update Environment",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.inngest.com/v2/envs/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Partially updates an environment's mutable fields."
        }
      ]
    }
  ],
  "bundled": true
}