{
  "opencollection": "1.0.0",
  "info": {
    "name": "Inngest REST Account Keys API",
    "version": "2026-05"
  },
  "items": [
    {
      "info": {
        "name": "Keys",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Event Keys",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.inngest.com/v2/keys/events",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Lists event keys (used for /e/{eventKey} ingestion) for the account."
        },
        {
          "info": {
            "name": "List Signing Keys",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.inngest.com/v2/keys/signing",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Lists signing keys (used to authenticate management API calls) for the account."
        }
      ]
    }
  ],
  "bundled": true
}