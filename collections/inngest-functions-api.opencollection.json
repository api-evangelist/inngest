{
  "opencollection": "1.0.0",
  "info": {
    "name": "Inngest REST Account Functions API",
    "version": "2026-05"
  },
  "items": [
    {
      "info": {
        "name": "Functions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Functions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.inngest.com/v1/functions",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Lists all functions deployed to the current Inngest environment."
        },
        {
          "info": {
            "name": "Invoke Function",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.inngest.com/v2/apps/:appId/functions/:functionId/invoke",
            "params": [
              {
                "name": "appId",
                "value": "",
                "type": "path"
              },
              {
                "name": "functionId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Invokes a deployed Inngest function asynchronously or synchronously."
        }
      ]
    }
  ],
  "bundled": true
}